# Cardinal — copiez ce fichier en .env. Toutes les variables sont optionnelles sauf mention.
PFLUX_PORT=8787                 # port d'écoute
# PFLUX_HOST=                   # adresse d'écoute (défaut 127.0.0.1 ; 0.0.0.0 dans compose)
# PFLUX_EXPOSE=1                # 1 = accès réseau, exige PFLUX_PASSWORD
# PFLUX_PASSWORD=               # mot de passe (≥ 12 caractères), requis si PFLUX_EXPOSE=1
# PFLUX_SESSION_SECRET=         # secret de session (≥ 32 octets), sinon généré dans /data/session.key
# PFLUX_TRUST_PROXY=1           # derrière un reverse proxy HTTPS
# PFLUX_PUBLIC_URL=             # URL publique (liens ntfy), sans slash final
# PFLUX_DATA_DIR=/data          # répertoire des données (./data hors production)
# PFLUX_SSRF_ALLOWLIST=192.168.1.20:8080   # hôtes privés autorisés (ex. ntfy LAN)
# PFLUX_FETCH_MAX_BYTES=5242880 # taille max d'une réponse récupérée
# PFLUX_FETCH_TIMEOUT_MS=15000  # délai max d'une requête
# PFLUX_MAX_CONCURRENT_RUNS=1   # runs simultanés (1..8)
# PFLUX_SCHEDULER_TICK_S=60     # période du planificateur en secondes
# PFLUX_DEFER_MINUTES=60        # report d'un run si Claude indisponible
# PFLUX_RETENTION_DAYS=0        # purge des anciens digests (0 = conserver)
# PFLUX_TZ=Europe/Paris         # fuseau IANA
# PFLUX_DEFAULT_MODEL=sonnet    # modèle par défaut des nouveaux flux
# PFLUX_ANTHROPIC_API_KEY=      # clé API (sinon connexion via la console de l'interface)
# PFLUX_NVD_API_KEY=            # clé API NVD (limites plus hautes)
# PFLUX_NTFY_TOKEN=             # jeton d'accès ntfy
# PFLUX_MCP_TOKEN=              # active /mcp (≥ 32 car., ex. `openssl rand -hex 32`)
# PFLUX_CLAUDE_BIN=             # chemin du binaire claude
# PFLUX_CLAUDE_RUNNER=cli       # cli | fake (tests uniquement)
# PFLUX_LOG_LEVEL=info          # fatal|error|warn|info|debug|trace
# PFLUX_IN_CONTAINER=1          # positionné par l'image Docker
